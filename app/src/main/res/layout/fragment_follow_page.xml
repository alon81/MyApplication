<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".fragments.FollowPageFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <!-- Category Button -->
            <ImageButton
                android:id="@+id/imageButtonSelectCategory"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_filter_list"
                android:contentDescription="Select Category"
                app:tint="#ffffff"
                android:layout_marginEnd="12dp" />

            <!-- Add Category button -->
            <Button
                android:id="@+id/buttonAddCategorySources"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add by Category"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:paddingVertical="12dp"
                android:paddingHorizontal="16dp"
                android:minHeight="48dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginEnd="8dp"
                android:background="@android:color/transparent"
                android:gravity="center_vertical" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <!-- EditText name -->
            <EditText
                android:id="@+id/editTextSourceName"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Enter source name"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#B0B0B0"
                android:textSize="16sp"
                android:layout_marginEnd="12dp"
                android:backgroundTint="#1F1F1F"
                android:drawablePadding="8dp"
                android:background="@android:color/transparent" />

            <!-- Add Name button -->
            <Button
                android:id="@+id/buttonAddSource"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add by Name"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:paddingVertical="12dp"
                android:paddingHorizontal="16dp"
                android:minHeight="48dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:gravity="center_vertical" />
        </LinearLayout>

        <!-- RecyclerView for followed sources -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFollowedSources"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:scrollbars="vertical"
            android:background="#1F1F1F"
            android:elevation="6dp" />

        <!-- Remove All Sources Button -->
        <Button
            android:id="@+id/removeAllSourcesButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Remove All Sources"
            android:textColor="#FF5252"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:background="@android:color/transparent"
            android:textAllCaps="false"
            android:padding="12dp"
            android:layout_gravity="center_vertical"
            android:drawablePadding="8dp"
            android:backgroundTint="#FF5252" />
    </LinearLayout>
</FrameLayout>
