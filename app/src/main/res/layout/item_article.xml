<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:backgroundTint="#121212"
    android:background="#1A1A1A"
    android:elevation="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Left Side: Star and Arrow -->
        <LinearLayout
            android:id="@+id/iconsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical">

            <!-- Favorite -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgFavoriteStar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Favorite Star"
                android:tint="#B0B0B0"
                android:layout_marginEnd="12dp"
                app:srcCompat="@drawable/ic_fav" />

            <!-- Send Email Arrow -->
            <ImageView
                android:id="@+id/imgSendEmail"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_share"
                android:contentDescription="Send Article Email"
                android:clickable="true"
                android:focusable="true"
                app:tint="#B0B0B0" />

        </LinearLayout>

        <!-- Right Side: Title and Source -->
        <LinearLayout
            android:id="@+id/textContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_toEndOf="@id/iconsContainer"
            android:layout_marginStart="16dp"
            android:gravity="start">

            <!-- Title -->
            <TextView
                android:id="@+id/txtArticleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Article Title"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="6dp" />

            <!-- Source -->
            <TextView
                android:id="@+id/txtArticleSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Source"
                android:textSize="14sp"
                android:textColor="#B0B0B0"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>
