<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="Follow News Sources"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center" />

    <!-- EditText to enter the source name -->
    <EditText
        android:id="@+id/editTextSourceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter source name"
        android:inputType="text"
        android:minHeight="48dp" />

    <!-- Button to add source to favorites -->
    <Button
        android:id="@+id/buttonAddSource"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add to Favorites"
        android:onClick="onAddSourceButtonClicked" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFollowedSources"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
