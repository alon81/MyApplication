<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#121212"
    tools:context=".fragments.ChangeInfoFragment">

    <!-- ConstraintLayout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp">

        <!-- Button for Favoriting  -->
        <ImageButton
            android:id="@+id/imgFavoriteStar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@android:color/transparent"
            android:contentDescription="Favorites"
            android:src="@drawable/ic_fav"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Notification Button -->
        <ImageButton
            android:id="@+id/notificationButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:background="@android:color/transparent"
            android:contentDescription="Notifications"
            android:src="@drawable/ic_noti"
            android:padding="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFFFFF" />

        <!-- Email Label -->
        <TextView
            android:id="@+id/txtEmailLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email:"
            android:textSize="22sp"
            android:textColor="#03DAC5"
            android:textStyle="bold"
            android:layout_marginTop="80dp"
            app:layout_constraintTop_toBottomOf="@id/notificationButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:elevation="1dp" />

        <!-- Email Text -->
        <TextView
            android:id="@+id/txtEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="user@example.com"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/txtEmailLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:letterSpacing="0.01" />

        <!-- First Name Label -->
        <TextView
            android:id="@+id/txtFirstNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="First Name:"
            android:textSize="22sp"
            android:textColor="#03DAC5"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/txtEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:letterSpacing="0.02"
            android:elevation="1dp" />

        <!-- First Name Input -->
        <EditText
            android:id="@+id/etFirstName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="8dp"
            android:hint="Enter First Name"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0B0B0"
            android:inputType="textPersonName"
            android:minHeight="50dp"
            android:padding="12dp"
            android:backgroundTint="#03DAC5"
            android:layout_gravity="center"
            app:layout_constraintTop_toBottomOf="@id/txtFirstNameLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@android:color/transparent"
            android:letterSpacing="0.01" />

        <!-- Last Name Label -->
        <TextView
            android:id="@+id/txtLastNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last Name:"
            android:textSize="22sp"
            android:textColor="#03DAC5"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/etFirstName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:letterSpacing="0.02"
            android:elevation="1dp" />

        <!-- Last Name Input -->
        <EditText
            android:id="@+id/etLastName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="8dp"
            android:hint="Enter Last Name"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0B0B0"
            android:inputType="textPersonName"
            android:minHeight="50dp"
            android:padding="12dp"
            android:backgroundTint="#03DAC5"
            android:layout_gravity="center"
            app:layout_constraintTop_toBottomOf="@id/txtLastNameLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@android:color/transparent"
            android:letterSpacing="0.01" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveChanges"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Save Changes"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#03DAC5"
            android:padding="14dp"
            android:layout_marginTop="40dp"
            android:layout_marginHorizontal="40dp"
            android:layout_marginBottom="30dp"
            app:layout_constraintTop_toBottomOf="@id/etLastName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:cornerRadius="8dp"
            android:elevation="4dp"
            android:letterSpacing="0.02" />

        <!-- Log Out Button -->
        <Button
            android:id="@+id/logoutButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log Out"
            android:textColor="#FF5252"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/btnSaveChanges"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:letterSpacing="0.02"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>